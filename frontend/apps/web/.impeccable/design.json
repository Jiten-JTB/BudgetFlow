  "narrative": {
    "northStar": "The Merchant's Ledger",
    "overview": "Budget Flow keeps money the way a merchant keeps the bahi-khata: what came in on one page, what went out on the facing page, and the balance struck at the spine. A vermilion bookcloth rail with a turmeric thread binds the app; the work happens on quiet white sheets laid on a pale ledger page, written in indigo ink.\n\nThe system is precise and quiet. Controls are standard and calm, so the numbers carry the weight: exact, tabular, signed, and always traceable to their ledger lines. Colour does real jobs (direction of money, state, the one primary action) and nothing is decoration. It is never gamified.",
    "keyCharacteristics": [
      "Facing-page spread with the balance struck at the spine",
      "Vermilion rail, turmeric thread, indigo ink on a pale page",
      "Mukta with tabular figures and one fixed money ramp",
      "States said in words, never colour alone",
      "Standard web controls; no ledger costume"
    ],
    "rules": [
      {
        "name": "The Facing Pages Rule",
        "section": "overview",
        "body": "Money in sits on the left page, money out on the right, and the balance is struck at the spine between them. Never collapse the spread into KPI cards."
      },
      {
        "name": "The One Thread Rule",
        "section": "colors",
        "body": "Turmeric marks exactly one thing per screen: the primary action (Add transaction), plus the rail's binding edge and budget warnings. It is never text or a focus ring on light surfaces (2.2:1)."
      },
      {
        "name": "The Signed Amount Rule",
        "section": "colors",
        "body": "Money out is vermilion, money in indigo, and every amount also carries its sign or sits under a heading that names its direction. Colour never carries meaning alone."
      },
      {
        "name": "The Fixed Ramp Rule",
        "section": "typography",
        "body": "Amounts use only the five money sizes (2.5, 1.75, 1.25, 0.9375, 0.8125 rem) with tabular lining figures. Hierarchy is never improvised."
      },
      {
        "name": "The Quiet Sheet Rule",
        "section": "elevation",
        "body": "Sheets lift off the page with one soft indigo-tinted shadow; nothing else casts one. Depth says 'this is a page of the book', never 'click me'."
      }
    ],
    "dos": [
      "Do format every amount with formatMoney (exact decimal strings, the reader's locale, a true minus sign).",
      "Do say states in words: Confirming, Cancelled: <reason>, ₹1,900.00 over.",
      "Do use the indigo focus ring (2px, 2px offset) on light surfaces and turmeric only on the vermilion rail.",
      "Do keep controls standard web controls: native selects, date inputs, radio groups, disclosure menus.",
      "Do give every money list a total, and let every line open to its transactions."
    ],
    "donts": [
      "Don't use ruled-paper textures, stitched borders or other ledger costume on working screens.",
      "Don't put eyebrow labels above headings or join meta with middle dots.",
      "Don't draw icons with Unicode glyphs or emoji; use the lucide set at 1.75 stroke.",
      "Don't gamify: no streaks, badges, confetti or mascots.",
      "Don't spread turmeric beyond the primary action, the rail edge and warnings."
    ]
  }
}